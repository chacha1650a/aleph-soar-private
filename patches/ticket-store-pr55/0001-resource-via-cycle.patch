+def test_restored_ticket_rejects_new_application_until_closed_without_losing_event(apps):
+    n8n, dashboard, path = apps
+    first = record(n8n, s12(), "cycle-1-applied").get_json()
+    record(n8n, s12("released", action="unblock", result="released"), "cycle-1-released")
+    new = {**s12(), "event_ids": ["cycle-2-event"]}
+    detected = record(n8n, {**new, "stage": "detected", "action": None}, "cycle-2-detected")
+    assert detected.status_code == 409
+    conflict = record(n8n, new, "cycle-2-applied")
+    assert conflict.status_code == 409
+    assert conflict.get_json()["error"]["code"] == "INVALID_TRANSITION"
+    assert stored(path, first["ticket_id"])["event_ids"] == s12()["event_ids"]
+    assert len(stored(path, first["ticket_id"])["actions"]) == 2
+    with db.connect(path) as conn:
+        db.close_ticket(conn, first["ticket_id"], "restored; next cycle")
+    # Reuse the SAME key/body after resolving the conflict; no poisoned idempotency row.
+    fresh = record(n8n, new, "cycle-2-applied")
+    assert fresh.status_code == 201 and fresh.get_json()["duplicate"] is False
+    assert fresh.get_json()["ticket_id"] != first["ticket_id"]
+    assert resource_check(n8n).get_json()["tickets"][0]["ticket_id"] == fresh.get_json()["ticket_id"]
+    assert record(n8n, new, "cycle-2-applied").get_json() == fresh.get_json()
