{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "scenario_id": {
      "enum": [
        "S8",
        "S10"
      ]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "profile": {
      "enum": [
        "precheck",
        "baseline",
        "postchange"
      ]
    },
    "environment": {
      "enum": [
        "fixture",
        "lab"
      ]
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-D][.][a-z0-9_]+$"
      },
      "maxItems": 30
    },
    "expected_versions": {
      "type": "object",
      "properties": {
        "A": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "B": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "C": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "D": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "source_ip": {
      "type": "string",
      "format": "ipv4"
    },
    "target_ip": {
      "type": "string",
      "format": "ipv4"
    },
    "input_start": {
      "type": "string",
      "format": "date-time"
    },
    "input_end": {
      "type": "string",
      "format": "date-time"
    },
    "observation_end": {
      "type": "string",
      "format": "date-time"
    },
    "prepare_valid_for_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "expected_input_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "expected_event_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "input_owner": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "reviewer": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "profile_id",
    "profile",
    "environment",
    "required_checks",
    "expected_versions",
    "source_ip",
    "target_ip",
    "input_start",
    "input_end",
    "observation_end",
    "prepare_valid_for_seconds",
    "expected_input_count",
    "expected_event_count",
    "input_owner",
    "reviewer",
    "policy_sha256"
  ],
  "additionalProperties": false
}
