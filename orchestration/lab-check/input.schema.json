{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "card_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment": {
      "enum": [
        "fixture",
        "lab"
      ]
    },
    "origin": {
      "enum": [
        "synthetic",
        "reported",
        "direct"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_ip": {
      "type": "string",
      "format": "ipv4"
    },
    "target_ip": {
      "type": "string",
      "format": "ipv4"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "card_sha256",
    "environment",
    "origin",
    "started_at",
    "ended_at",
    "source_ip",
    "target_ip",
    "count",
    "execution_id"
  ],
  "additionalProperties": false
}
