{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 300
    },
    "jobs": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "seat": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "seat",
          "profile"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "max_workers",
    "timeout_seconds",
    "jobs"
  ],
  "additionalProperties": false
}
